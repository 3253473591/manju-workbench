# 复制为 .env 后填入真实值；.env 已在 .gitignore 里，绝不提交。
# 密钥只由后端读取：不进入浏览器、API 响应、日志、版本正文或输入快照。

APP_MODE=mock

# --- 数据库 -------------------------------------------------------------
# 应用库（自动建库 → Alembic → seed 都打这个库）。
# `root:root` 只是示例占位：换成你自己的账号，密码里有特殊字符要按 URL 规则转义。
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/manju_director?charset=utf8mb4
#
# 测试库**不写在这里**：测试会 drop / TRUNCATE 目标库，所以 backend/tests/conftest.py
# 只认独立的环境变量 MANJU_TEST_DATABASE_URL（库名必须以 _test 结尾），
# 并且拒绝读 DATABASE_URL。跑测试前在 shell 里设：
#   $env:MANJU_TEST_DATABASE_URL = "mysql+pymysql://<user>:<password>@127.0.0.1:3306/manju_director_test?charset=utf8mb4"
# 该账号需要能 CREATE DATABASE、跑 Alembic 迁移、TRUNCATE 表。

# --- 本地初始化管理员 ---------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# --- 火山方舟（只接官方）------------------------------------------------
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 豆包：文本与提示词
ARK_DOUBAO_API_KEY=
ARK_DOUBAO_MODEL=ep-20260917112408-5v5pr

# Seedream：图片。lite / pro 可以是两把不同的 Key；
# 只填 ARK_SEEDREAM_API_KEY 时两档共用同一把。
ARK_SEEDREAM_API_KEY=
ARK_SEEDREAM_LITE_API_KEY=
ARK_SEEDREAM_PRO_API_KEY=
ARK_SEEDREAM_LITE_MODEL=ep-20260920164208-q8z6z
ARK_SEEDREAM_PRO_MODEL=ep-20260920164144-9g86q

# Seedance：视频（三个档位各自一把 Key）
ARK_SEEDANCE_MINI_API_KEY=
ARK_SEEDANCE_MINI_MODEL=ep-20260911123900-jzrcv
ARK_SEEDANCE_FAST_API_KEY=
ARK_SEEDANCE_FAST_MODEL=ep-20260911124121-s98bf
ARK_SEEDANCE_25_API_KEY=
ARK_SEEDANCE_25_MODEL=ep-20260911124159-mkx2n

# --- 本地开发端口说明 ---------------------------------------------------
# 后端默认 8010、前端默认 5173。若端口被占用：
#   后端：python -m uvicorn app.main:app --port 8020
#   前端：MANJU_BACKEND=http://127.0.0.1:8020 MANJU_WEB_PORT=5180 npm run dev
