# 全部可选：不建 .env 时 compose 用内置默认值也能起（零 key 可跑）
# 复制成 .env 再改，或直接用环境变量覆盖。

# --- 数据库 ---
MYSQL_ROOT_PASSWORD=devpass
MYSQL_DATABASE=manju_dev
MYSQL_PORT=3306

# --- 后端 ---
JWT_SECRET=dev-secret-change-me-dev-secret-32
CSRF_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 你的剧集目录（含 剧本.md / Seedance2.0终剪提示词.md / 静态资源），挂进容器的 /media
MEDIA_HOST_PATH=./media
# 质检脚本（可选）；例如 Windows 上是 D:\AIGC\ComfyUI-aki-v2\tools\vscan.ps1
# 容器内没有 powershell，所以容器里通常留空 = 质检降级
VSCAN_PATH=

# --- provider（默认 mock，零 key 可跑；换真 key 只需改这组）---
# 文本/视觉：mock 或 openai（任何 OpenAI 兼容的 /chat/completions）
PROVIDER=mock
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_TEXT_MODEL=
PROVIDER_VISION_MODEL=
PROVIDER_TIMEOUT=120
# 视频：mock 或 ark（火山方舟 Seedance，真出片）
PROVIDER_VIDEO=mock
PROVIDER_VIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
PROVIDER_VIDEO_API_KEY=
PROVIDER_VIDEO_MODEL=
PROVIDER_VIDEO_RESOLUTION=720p
# 真视频按 token 计费：元/千 token（默认值由项目实测常数反推，换档位就改）
PROVIDER_VIDEO_PRICE_PER_1K_TOKENS=0.008727

# --- 端口 ---
API_PORT=8000
WEB_PORT=8080

# 出图（人物卡/参考图）：mock 或 images（OpenAI Images 兼容）
PROVIDER_IMAGE=mock
PROVIDER_IMAGE_BASE_URL=
PROVIDER_IMAGE_API_KEY=
PROVIDER_IMAGE_MODEL=gpt-image-2
PROVIDER_IMAGE_SIZE=1024x1024
PROVIDER_IMAGE_QUALITY=low
PROVIDER_IMAGE_PRICE_PER_IMAGE=0
